# Copiar a .env y completar. Nunca subir .env al repositorio.
DB_PASSWORD=cambia-esta-clave
JWT_SECRET=genera-uno-largo-con-openssl-rand-hex-32
# Dominio DNS de la VM. Con un dominio, Caddy activa HTTPS automático (Let's Encrypt).
SITE_ADDRESS=edumaster-linux.northcentralus.cloudapp.azure.com
SEED_DEMO=true
# IP pública de la VM para entrar también por http://<IP> (deploy.sh la detecta en Azure).
PUBLIC_IP=23.100.76.169
FRONTEND_DIR=../edumaster-frontend
